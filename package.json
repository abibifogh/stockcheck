{
  "name": "niceoperation-breakfast",
  "version": "1.0.0",
  "private": true,
  "description": "Breakfast inventory & consumption analytics for hotel breakfast units",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:housekeeping": "wrangler dev -c wrangler.housekeeping.toml",
    "deploy": "wrangler deploy",
    "deploy:housekeeping": "wrangler deploy -c wrangler.housekeeping.toml",
    "db:create": "wrangler d1 create breakfast",
    "db:migrate": "wrangler d1 migrations apply breakfast --remote",
    "db:migrate:local": "wrangler d1 migrations apply breakfast --local",
    "db:seed": "wrangler d1 execute breakfast --remote --file=./seed/starter.sql",
    "db:seed:local": "wrangler d1 execute breakfast --local --file=./seed/starter.sql",
    "dev:correspondence": "wrangler dev -c wrangler.correspondence.toml",
    "deploy:correspondence": "wrangler deploy -c wrangler.correspondence.toml",
    "co:db:create": "wrangler d1 create correspondence",
    "co:bucket:create": "wrangler r2 bucket create practice-documents",
    "co:db:migrate": "wrangler d1 execute correspondence --remote -c wrangler.correspondence.toml --file=./seed/correspondence-database.sql",
    "co:db:migrate:local": "wrangler d1 execute correspondence --local -c wrangler.correspondence.toml --file=./seed/correspondence-database.sql",
    "co:db:seed": "wrangler d1 execute correspondence --remote -c wrangler.correspondence.toml --file=./seed/correspondence-starter.sql",
    "co:db:seed:local": "wrangler d1 execute correspondence --local -c wrangler.correspondence.toml --file=./seed/correspondence-starter.sql",
    "build:seed": "node scripts/build-seed.mjs",
    "test": "node --test \"test/**/*.test.js\"",
    "sql:console": "node scripts/console-sql.mjs"
  },
  "devDependencies": {
    "http_ece": "^1.2.1",
    "wrangler": "^4.20.0"
  }
}
