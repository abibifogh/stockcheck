{
  "name": "niceoperation-breakfast",
  "version": "1.0.0",
  "private": true,
  "description": "Breakfast inventory & consumption analytics for hotel breakfast units",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create breakfast",
    "db:migrate": "wrangler d1 migrations apply breakfast --remote",
    "db:migrate:local": "wrangler d1 migrations apply breakfast --local",
    "db:seed": "wrangler d1 execute breakfast --remote --file=./seed/starter.sql",
    "db:seed:local": "wrangler d1 execute breakfast --local --file=./seed/starter.sql",
    "test": "node --test \"test/**/*.test.js\""
  },
  "devDependencies": {
    "http_ece": "^1.2.1",
    "wrangler": "^4.20.0"
  }
}
